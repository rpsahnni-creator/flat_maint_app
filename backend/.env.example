# Django Environment
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-please-use-a-strong-secret-key

# Database (local PostgreSQL)
DB_NAME=society_manager_dev
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

ALLOWED_HOSTS=localhost,127.0.0.1,testserver

FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8001

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Dev email (file-based outbox under backend/logs/outbox)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@navyanamanvatika.com

DJANGO_LOG_LEVEL=INFO

