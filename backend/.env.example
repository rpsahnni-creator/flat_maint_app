# Django Environment
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-please-use-a-strong-secret-key

# Database Configuration (local PostgreSQL 18)
DB_NAME=society_manager_dev
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8001

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth Configuration
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Email Configuration (Development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@greenvalley.com

# Django Logging
DJANGO_LOG_LEVEL=INFO

# Production toggles (set when DJANGO_ENV=production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
